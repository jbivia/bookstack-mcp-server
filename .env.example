# Racine du wiki BookStack. Le /api final est optionnel.
BOOKSTACK_BASE_URL=https://wiki.example.com

# BookStack > Edit Profile > API Tokens > Create Token
# Le role du compte doit aussi avoir la permission "Access system API".
BOOKSTACK_TOKEN_ID=
BOOKSTACK_TOKEN_SECRET=

# Si le wiki utilise une CA privee, decommenter et pointer sur le certificat racine :
# NODE_EXTRA_CA_CERTS=/chemin/vers/ca.pem
